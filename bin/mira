#!/usr/bin/env node
// The `mira` CLI: a thin client over Mira's control socket (docs/socket.md).
// Pure logic lives in ../src/cli/mira-core.mjs (unit-tested); this file is the
// I/O shell — it connects, sends ONE JSON request, reads the reply until the
// newline the server always appends, prints it, and sets the exit code.
//
// Why this exists instead of `printf ... | nc -U`: macOS `nc` closes on stdin
// EOF and drops the async reply (exec-js returns 0 bytes — a false "empty" that
// wastes hours). This reads until '\n', so async commands reply reliably.
//
// Tab targeting is stateful via the ENVIRONMENT only (never a shared file):
//   --tab <id>  >  $MIRA_TAB  >  focused window's active tab
// so parallel sessions never clobber each other's target. `mira use` prints an
// `export MIRA_TAB=<id>` line to pin a tab for the rest of the shell session.
//
// Inside a Claude Code session (CLAUDE_CODE_SESSION_ID set) and with no explicit
// target, tab verbs land in that SESSION's own window instead of the focused one:
// Mira opens it on first use, below the window you are working in, and closes it
// on `mira done` or when the session's process exits. MIRA_NO_SESSION_WINDOW=1
// turns this off.
//
// Every request carries a `client` (Mira refuses one without, see docs/socket.md):
// `mira-cli session=<CLAUDE_CODE_SESSION_ID> cwd=<dir>`, prefixed by $MIRA_CLIENT
// when set. Mira writes it to <userData>/command.log next to each command.
//
// Usage:
//   mira tabs [--window <id>]       list tabs (id / title / url), * = active, z = asleep, ♪ = playing sound
//   mira tabs --profile <p>         list the user's window of that profile (label or id prefix)
//                                   (--window: any window from `mira windows`, else the focused one)
//   mira tabs --session [--profile <p>]  list THIS Claude session's own window (never opens one)
//   mira use --url <substr>         resolve a tab by url, print export MIRA_TAB=<id>
//   mira use --active               pin the focused window's active tab
//   mira use <id>                   pin an explicit id
//   mira exec <code|-|@file>        run JS in the pinned/active tab; prints {"ok":…,"result":…}
//                                   (--bare: the result alone, exit 1 on failure — for shell tests)
//   mira upload <file>... [--selector <css>] [--nth <n>]   put local files into the page's <input type=file>
//                                   (no native picker; chunked so big files pass the exec timeout;
//                                    default selector input[type=file], --nth picks among matches)
//   mira press <key> [--mod a,b]    send a real keypress (e.g. e, Enter, ArrowDown)
//   mira click --selector <css>|--text <str>|--at <x,y>   a REAL mouse click (CDP), not a synthetic MouseEvent
//                                   (--nth <n>: pick among several matches, 1-based; --scroll: scroll it in view first)
//   mira snap                       the page as a numbered table of what it lets you do + its visible text
//   mira click <ref>                click element [ref] from the last snap (also --ref <n>)
//   mira type <ref> <text>          replace the text of field [ref] (real click + CDP text insertion)
//   mira type --focused <text>      same, into the field that has focus (no ref, no click): iframes
//   mira select <ref> <label>       pick a native dropdown option by label (--value <v>: by value)
//                                   A ref action is REFUSED once the page moved since the snap: snap again.
//   mira wait --selector <css>|--text <str>|--url <substr>|--host <domain>  block until it holds, instead of sleeping blind
//                                   (--gone: wait for it to disappear; --timeout <ms>, default 5000)
//                                   --url matches anywhere in the address, query string included; to know
//                                   which SITE the tab is on (after a login redirect), use --host
//   mira batch <@file|-> [--keep-going]   run many lines over ONE connection: one process, one agent turn
//                                   (a line = what you'd type after `mira`; # comments and blanks ignored;
//                                    stops at the first failure unless --keep-going)
//   mira reload                     reload the pinned or active tab (on the error page: retries the url that failed)
//   mira console [--level e][--limit n][--since seq]  captured page console, iframes included (console.* + 403/CORS/CSP/exceptions)
//   mira shot [path] [--full]       screenshot the pinned/active tab to a PNG (default: userData/screenshots/)
//                                   (--full: the whole document, not just the viewport)
//   mira nav <url> [--new-tab|-n]   navigate the pinned/active tab in place (--new-tab: open a fresh tab instead)
//   mira open <url> [--background|-b]  open <url> in a NEW tab, leaving the current tab untouched
//                                   With SEVERAL profiles open and no --tab/$MIRA_TAB, both refuse
//                                   to guess a window: pass --window <id> or --profile <id-prefix>.
//                                   (--background: load it hidden — the window does not switch to it)
//                                   (both honour --tab / $MIRA_TAB: the pinned tab's WINDOW is the target)
//                                   In a Claude session, `open` / `nav -n` on a profile that already has
//                                   a window of the user's open add the tab THERE, not in a session window.
//   mira close-tab --tab <id>       close that tab (id from `mira tabs`, resolved across windows)
//                                   (no --tab: the pinned/active one; `mira discard-tab` puts it to sleep instead)
// No command here ever brings Mira to the foreground; `mira focus` is the explicit way.
//   mira focus [--window <id>]      bring one window to the front (default: Mira's last-focused one)
//   mira focus --tab <id>           make that tab active and raise ITS window
//   mira windows                    list open windows (id / profile / tabs), * = focused
//   mira done                       close this Claude session's own window (see above)
//   mira watch                      follow the focused tab live (profile / folder / title / url), until Ctrl-C
//                                   (--json: one raw event per line, for a program)
//   mira quit                       quit Mira entirely (close-profile never quits; this is the explicit exit)
//   mira cookies [--url <url>]      print the active site's cookie string (HttpOnly incl.); for export KONDO_COOKIE="$(mira cookies)"
//                 [--netscape]      print a Netscape cookie jar instead, for yt-dlp --cookies / curl -b
//   mira forget <domain> [--profile <id>]  wipe a domain's cookies + storage + history (all subdomains); no tab needed
//   mira commands                   list every command the running build knows
//   mira call <command> [--params '<json>']   generic passthrough to any command
//   mira <command> [--params '<json>']        same, shorthand
// Global flags: --tab <id>, --json (raw response), --socket <path>.

import { createConnection } from 'node:net'
import { execFileSync } from 'node:child_process'
import { readFileSync } from 'node:fs'
import { homedir } from 'node:os'
import { fileURLToPath } from 'node:url'
import { dirname, resolve } from 'node:path'
import {
  clientName,
  withClient,
  parseArgs,
  resolveTabId,
  sessionTarget,
  sessionTabsTarget,
  matchProfileId,
  profileWindow,
  userWindowForOpen,
  pickTabByUrl,
  buildExec,
  buildReload,
  buildPress,
  buildCall,
  buildNav,
  buildFocus,
  buildActivateTab,
  buildConsole,
  buildScreenshot,
  formatScreenshot,
  formatTabs,
  formatConsole,
  formatWindows,
  formatFocus,
  resolveCode,
  resolveTimeoutMs,
  background,
  resolveNavTarget,
  buildClick,
  buildWait,
  buildSnapshot,
  clickPositional,
  buildType,
  typePlan,
  buildSelect,
  formatSnapshot,
  parseBatchScript,
  buildBatch,
  formatBatchResults,
  buildUploadScripts,
  timeoutMessage,
  socketPathError,
  PROBE_TIMEOUT_MS
} from '../src/cli/mira-core.mjs'

const HERE = dirname(fileURLToPath(import.meta.url))

/** Who this CLI run is, sent with every request (Mira refuses one without). */
const CLIENT = clientName(process.env, process.cwd())

/** Send one request object, resolve with the parsed JSON reply. Reads until the
 * first newline (the server appends one per response). */
function call(request, socketPath, timeoutMs = 30000) {
  return new Promise((resolveP, reject) => {
    const conn = createConnection(socketPath)
    let buf = ''
    conn.setTimeout(timeoutMs)
    conn.on('connect', () => conn.write(JSON.stringify(withClient(request, CLIENT)) + '\n'))
    conn.on('data', (chunk) => {
      buf += chunk.toString()
      const nl = buf.indexOf('\n')
      if (nl >= 0) {
        conn.end()
        try {
          resolveP(JSON.parse(buf.slice(0, nl)))
        } catch (e) {
          reject(new Error(`bad reply: ${buf.slice(0, nl)}`))
        }
      }
    })
    let timedOut = false
    conn.on('timeout', () => {
      timedOut = true
      conn.destroy()
      explainTimeout(socketPath, timeoutMs).then(reject)
    })
    conn.on('error', (e) => {
      if (e && e.code === 'ENOENT')
        reject(new Error(`no Mira socket at ${socketPath} (is Mira running?)`))
      else if (e && e.code === 'ECONNREFUSED')
        reject(new Error(`stale socket at ${socketPath} (Mira not listening)`))
      else reject(e)
    })
    // A connection closed before any reply line (Mira quit or crashed mid-request)
    // used to leave the promise pending: node then exited 0 with nothing printed.
    conn.on('close', () => {
      if (!timedOut && buf.indexOf('\n') < 0)
        reject(new Error('Mira closed the connection without answering (quit or crashed?)'))
    })
  })
}

/** After a timeout, tell a slow command from a frozen Mira: a frozen main process
 * still accepts the connection (the kernel queues it) but never answers, so a
 * bare "timed out" left the caller guessing whether to wait or to kill. One cheap
 * `version` on a fresh connection settles it. */
function explainTimeout(socketPath, timeoutMs) {
  return new Promise((resolveP) => {
    const conn = createConnection(socketPath)
    let settled = false
    const done = (probe) => {
      if (settled) return
      settled = true
      conn.destroy()
      resolveP(
        new Error(timeoutMessage({ timeoutMs, probe, pid: probe === 'silent' ? miraPid() : null }))
      )
    }
    conn.setTimeout(PROBE_TIMEOUT_MS)
    conn.on('connect', () =>
      conn.write(JSON.stringify(withClient({ command: 'version' }, CLIENT)) + '\n')
    )
    conn.on('data', (chunk) => {
      if (chunk.toString().includes('\n')) done('answered')
    })
    conn.on('timeout', () => done('silent'))
    conn.on('error', () => done('silent'))
  })
}

/** Pid of the packaged Mira main process, or null (dev runs as Electron). */
function miraPid() {
  try {
    const out = execFileSync('pgrep', ['-x', 'Mira'], { encoding: 'utf8' }).trim().split('\n')[0]
    return out ? Number(out) : null
  } catch {
    return null
  }
}

/** Open ONE connection and run requests over it, in order, each awaiting its own
 * reply. This is what `mira batch` runs on.
 *
 * Why one connection: the socket round-trip is under a millisecond (measured
 * 2026-09-08), so what made driving Mira slow was never the daemon — it was one
 * node process, and above all one agent turn, per command. Twenty lines here
 * cost one of each.
 *
 * Why in order rather than firing everything at once: a batch stops at the first
 * failure by default, and everything after a missed click is noise against a
 * page that is not in the expected state. At sub-millisecond latency, awaiting
 * each reply costs nothing next to losing that guarantee.
 */
function openSession(socketPath, timeoutMs = 30000) {
  return new Promise((resolveP, reject) => {
    const conn = createConnection(socketPath)
    let buf = ''
    /** Replies come back in request order; each waiter is settled in turn. */
    const pending = []
    conn.setTimeout(timeoutMs)
    conn.on('data', (chunk) => {
      buf += chunk.toString()
      let nl
      while ((nl = buf.indexOf('\n')) >= 0) {
        const line = buf.slice(0, nl)
        buf = buf.slice(nl + 1)
        const waiter = pending.shift()
        if (!waiter) continue
        try {
          waiter.resolve(JSON.parse(line))
        } catch {
          waiter.reject(new Error(`bad reply: ${line}`))
        }
      }
    })
    conn.on('timeout', () => {
      conn.destroy()
      explainTimeout(socketPath, timeoutMs).then((e) => {
        while (pending.length) pending.shift().reject(e)
      })
    })
    conn.on('error', (e) => {
      const err =
        e && e.code === 'ENOENT'
          ? new Error(`no Mira socket at ${socketPath} (is Mira running?)`)
          : e && e.code === 'ECONNREFUSED'
            ? new Error(`stale socket at ${socketPath} (Mira not listening)`)
            : e
      if (pending.length) while (pending.length) pending.shift().reject(err)
      else reject(err)
    })
    conn.on('connect', () =>
      resolveP({
        ask: (request) =>
          new Promise((res, rej) => {
            pending.push({ resolve: res, reject: rej })
            conn.write(JSON.stringify(withClient(request, CLIENT)) + '\n')
          }),
        close: () => conn.end()
      })
    )
  })
}

/** Subscribe to the focus stream and print every line until the user stops us.
 * Unlike `call`, this connection stays open: the first line is the situation as
 * it stands, the rest arrive as they happen. */
function watch(socketPath, { json }) {
  return new Promise((_resolveP, reject) => {
    const conn = createConnection(socketPath)
    let buf = ''
    conn.on('connect', () =>
      conn.write(JSON.stringify({ client: CLIENT, cmd: 'subscribe', events: ['focus'] }) + '\n')
    )
    conn.on('data', (chunk) => {
      buf += chunk.toString()
      let nl
      while ((nl = buf.indexOf('\n')) >= 0) {
        const line = buf.slice(0, nl)
        buf = buf.slice(nl + 1)
        let msg
        try {
          msg = JSON.parse(line)
        } catch {
          continue
        }
        if (msg.ok === false) {
          conn.end()
          reject(new Error(msg.error ?? 'subscribe refused'))
          return
        }
        if (json) {
          process.stdout.write(line + '\n')
          continue
        }
        // The subscribe reply carries the snapshot under data.focus; every line
        // after it is an event carrying `tab`.
        const tab = msg.data ? msg.data.focus : msg.tab
        process.stdout.write(formatFocus(tab) + '\n')
      }
    })
    conn.on('end', () => reject(new Error('Mira closed the stream')))
    conn.on('error', (e) => {
      if (e && e.code === 'ENOENT')
        reject(new Error(`no Mira socket at ${socketPath} (is Mira running?)`))
      else reject(e)
    })
  })
}

/** The user's open window of the profile an agent `open` targets, or null to
 * fall back to the session window. The profile is the one named by --profile,
 * else the only profile with a window open; anything ambiguous returns null and
 * leaves the existing refusals to speak. */
async function userWindowTarget(agentSession, socketPath, timeoutMs) {
  const [profs, wins] = await Promise.all([
    call({ command: 'list-profiles' }, socketPath, timeoutMs).catch(() => null),
    call({ command: 'list-windows' }, socketPath, timeoutMs).catch(() => null)
  ])
  if (!profs?.ok || !wins?.ok) return null
  let profileId
  if (agentSession.profileFlag) {
    const match = matchProfileId(profs.profiles, agentSession.profileFlag)
    if ('error' in match) return null
    profileId = match.id
  } else {
    const open = [...new Set(wins.windows.map((w) => w.profileId))]
    if (open.length !== 1) return null
    profileId = open[0]
  }
  const own = await call(
    { command: 'find-session-window', params: { sessionId: agentSession.sessionId, profileId } },
    socketPath,
    timeoutMs
  ).catch(() => null)
  const ownWindow = own?.ok && own.found ? own.windowId : null
  return userWindowForOpen(wins.windows, profileId, ownWindow)
}

function die(msg, code = 1) {
  process.stderr.write(String(msg) + '\n')
  process.exit(code)
}

/** Print a response and exit with 0 on ok, 1 on failure. `pretty` overrides the
 * default JSON dump for the human-facing verbs.
 *
 * Exit MUST wait for the write to flush: process.exit() kills the process
 * before Node drains an async pipe write, which on macOS truncates output at the
 * 64KB pipe buffer (big `extension-console` dumps lost their tail). Passing the
 * exit as the write callback fires it only once the data has reached the OS. */
function report(res, { json, pretty } = {}) {
  let stream = process.stdout
  let text
  if (json || !pretty) text = JSON.stringify(res)
  else if (res.ok) text = pretty(res)
  else {
    stream = process.stderr
    text = JSON.stringify(res)
  }
  stream.write(text + '\n', () => process.exit(res.ok ? 0 : 1))
}

async function main() {
  const { command, positionals, flags } = parseArgs(process.argv.slice(2))
  const socketPath =
    (typeof flags.socket === 'string' && flags.socket) ||
    process.env.MIRA_SOCKET ||
    '/tmp/mira.sock'
  const badSocket = socketPathError(socketPath)
  if (badSocket) return die(badSocket, 2)
  const json = flags.json === true
  let tabId = resolveTabId({ flagTab: flags.tab, envTab: process.env.MIRA_TAB })

  if (!command || command === 'help' || flags.help) {
    process.stdout.write(
      readFileSync(resolve(HERE, 'mira'), 'utf8')
        .split('\n')
        .filter((l) => l.startsWith('//'))
        .map((l) => l.slice(3))
        .join('\n') + '\n'
    )
    // Bare `mira` is a usage error; an explicit `help` / `--help` is not.
    process.exit(command || flags.help ? 0 : 2)
  }

  // --timeout <seconds>: some commands wait on a human (the card vault unlock
  // bubble asks for a master password), and 30 s is not a human timeout.
  const timeoutMs = resolveTimeoutMs(flags)

  // An agent session with no explicit target works in its OWN window (see the
  // header): ask Mira for it (created on first use) and aim at its active tab.
  let agentSession = sessionTarget({ command, positionals, flags, tabId, env: process.env })

  // `open` (and `nav -n`) adds a tab and touches nothing else, so when the
  // profile already has a window of the USER's open, the tab goes there instead
  // of into a new session window: one more window per Claude session for a page
  // the user is meant to see was pure clutter (2026-10-13). In-place `nav` keeps
  // the session window — it would overwrite the user's active tab.
  const addsTab =
    command === 'open' || ((command === 'nav' || command === 'navigate') && flags['new-tab'] === true)
  if (agentSession && addsTab) {
    const userWin = await userWindowTarget(agentSession, socketPath, timeoutMs)
    if (userWin) {
      flags.window = userWin
      agentSession = null
      process.stderr.write(
        `mira: profile already open — new tab goes into its window ${userWin}; act on it with --tab <id>\n`
      )
    }
  }

  if (agentSession) {
    const { profileFlag, ...params } = agentSession
    if (profileFlag) {
      const profs = await call({ command: 'list-profiles' }, socketPath, timeoutMs).catch((e) =>
        die(e.message, 2)
      )
      if (!profs.ok) return die(JSON.stringify(profs), 1)
      const match = matchProfileId(profs.profiles, profileFlag)
      if ('error' in match) return die(match.error, 2)
      params.profileId = match.id
    }
    const res = await call({ command: 'session-window', params }, socketPath, timeoutMs).catch(
      (e) => die(e.message, 2)
    )
    if (res.ok) {
      if (res.tabId) tabId = res.tabId
    } else if (/Unknown command/.test(String(res.error ?? ''))) {
      process.stderr.write(
        'mira: the running Mira has no session windows (older build); using the focused window\n'
      )
    } else {
      return die(JSON.stringify(res), 1)
    }
  }

  const send = (req, opts) =>
    call(req, socketPath, timeoutMs)
      .then((res) => report(res, opts))
      .catch((e) => die(e.message, 2))

  // `nav` / `open` must never fall back to "whatever window is first". A CLI
  // call focuses no window, so that fallback silently crosses profiles — a
  // personal page landing in the work profile. With several profiles open and
  // no named target we refuse; with one we stay out of the way. Returns the tab
  // id to aim at (the chosen window's active tab), or the caller's own pin.
  const navTargetTab = async () => {
    if (tabId) return tabId
    const wins = await call({ command: 'list-windows' }, socketPath, timeoutMs).catch((e) =>
      die(e.message, 2)
    )
    if (!wins.ok) return die(JSON.stringify(wins), 1)
    // Profile ids are UUIDs; the labels are what a human (and `--profile perso`)
    // can actually match on. A failure here is not fatal: we degrade to ids.
    const profs = await call({ command: 'list-profiles' }, socketPath, timeoutMs).catch(() => null)
    const labels = Object.fromEntries((profs?.profiles ?? []).map((p) => [p.id, p.label ?? '']))
    const pick = resolveNavTarget(
      wins.windows,
      { tabId, windowFlag: flags.window, profileFlag: flags.profile },
      labels
    )
    if ('error' in pick) return die(pick.error, 2)
    if (!pick.windowId) return null
    const tabs = await call(
      { command: 'list-tabs', params: { windowId: pick.windowId } },
      socketPath,
      timeoutMs
    ).catch((e) => die(e.message, 2))
    if (!tabs.ok) return die(JSON.stringify(tabs), 1)
    if (!tabs.activeId) return die(`window ${pick.windowId} has no active tab`, 1)
    await assertTabTargeting(tabs.activeId, pick.windowId)
    return tabs.activeId
  }

  // Resolving the right window is worthless if the running Mira then ignores the
  // target. A build older than the tab-targeted `navigate` opens the new tab in
  // its own focused window instead — which means the page LOADS under another
  // profile's session, cookies and history included. That is the leak, and it is
  // silent: the response looks like a success.
  //
  // So before sending the real url we open `about:blank` at the target and check
  // where it landed. about:blank carries nothing, and the probe is closed right
  // after. A build that fails it gets a refusal naming the fix, never a page.
  const assertTabTargeting = async (targetTab, expectedWindow) => {
    const probe = await call(
      {
        command: 'navigate',
        params: { url: 'about:blank', newTab: true, background: true, tabId: targetTab }
      },
      socketPath,
      timeoutMs
    ).catch((e) => die(e.message, 2))
    if (!probe.ok || !probe.id)
      return die(`could not probe tab targeting: ${JSON.stringify(probe)}`, 2)
    const where = await call(
      { command: 'list-tabs', params: { windowId: expectedWindow } },
      socketPath,
      timeoutMs
    ).catch((e) => die(e.message, 2))
    const landed = (where.tabs ?? []).some((t) => t.id === probe.id)
    await call({ command: 'close-tab', params: { tabId: probe.id } }, socketPath, timeoutMs).catch(
      () => null
    )
    if (!landed) {
      return die(
        'the running Mira ignores the target window: a probe tab opened somewhere else.\n' +
          'Opening the page would load it under ANOTHER profile (its cookies, its history).\n' +
          'Refusing. The fix is in the working tree but not in the running build — rebuild and\n' +
          'restart Mira, then retry.',
        2
      )
    }
  }

  switch (command) {
    case 'tabs': {
      const req = { command: 'list-tabs' }
      if (typeof flags.window === 'string') req.params = { windowId: flags.window }
      // --profile without --session: the user's window of that profile. Resolved
      // here (list-windows), so it works on any running build.
      if (typeof flags.profile === 'string' && flags.session !== true) {
        if (typeof flags.window === 'string') return die('tabs: pass --window or --profile, not both', 2)
        const profs = await call({ command: 'list-profiles' }, socketPath, timeoutMs).catch((e) =>
          die(e.message, 2)
        )
        if (!profs.ok) return die(JSON.stringify(profs), 1)
        const match = matchProfileId(profs.profiles, flags.profile)
        if ('error' in match) return die(match.error, 2)
        const wins = await call({ command: 'list-windows' }, socketPath, timeoutMs).catch((e) =>
          die(e.message, 2)
        )
        if (!wins.ok) return die(JSON.stringify(wins), 1)
        const label = profs.profiles.find((p) => p.id === match.id)?.label
        const win = profileWindow(wins.windows, match.id, label)
        if ('error' in win) return die(win.error, 2)
        req.params = { windowId: win.windowId }
      }
      if (flags.session === true) {
        const st = sessionTabsTarget({ flags, env: process.env })
        if ('error' in st) return die(st.error, 2)
        const params = { sessionId: st.sessionId }
        if (st.profileFlag) {
          const profs = await call({ command: 'list-profiles' }, socketPath, timeoutMs).catch((e) =>
            die(e.message, 2)
          )
          if (!profs.ok) return die(JSON.stringify(profs), 1)
          const match = matchProfileId(profs.profiles, st.profileFlag)
          if ('error' in match) return die(match.error, 2)
          params.profileId = match.id
        }
        const found = await call(
          { command: 'find-session-window', params },
          socketPath,
          timeoutMs
        ).catch((e) => die(e.message, 2))
        if (!found.ok) return die(JSON.stringify(found), 1)
        if (!found.found) return die('tabs --session: this session has no window open yet', 1)
        req.params = { windowId: found.windowId }
      }
      return send(req, { json, pretty: (r) => formatTabs(r.tabs, r.activeId) })
    }

    case 'watch':
      return watch(socketPath, { json }).catch((e) => die(e.message, 2))

    case 'commands':
      return send(
        { command: 'list-commands' },
        { json, pretty: (r) => (r.commands ?? []).join('\n') }
      )

    case 'exec': {
      const cr = resolveCode(positionals[0], {
        readStdin: () => readFileSync(0, 'utf8'),
        readFile: (p) => readFileSync(p, 'utf8')
      })
      if ('error' in cr) return die(cr.error, 2)
      // Default stays the {"ok","result"} envelope (scripts parse it). --bare
      // prints the result alone, so a shell test on `true` cannot match `"ok":true`.
      if (flags.bare !== true) return send(buildExec(cr.code, tabId), { json })
      return send(buildExec(cr.code, tabId), {
        json,
        pretty: (r) => (typeof r.result === 'string' ? r.result : JSON.stringify(r.result ?? null))
      })
    }

    case 'upload': {
      const files = []
      for (const p of positionals) {
        try {
          files.push({ name: p.split('/').pop(), b64: readFileSync(resolve(p)).toString('base64') })
        } catch (e) {
          return die(`cannot read ${p}: ${e instanceof Error ? e.message : String(e)}`, 2)
        }
      }
      const up = buildUploadScripts(files, {
        selector: typeof flags.selector === 'string' ? flags.selector : undefined,
        nth: flags.nth !== undefined ? Number(flags.nth) : undefined
      })
      if ('error' in up) return die(up.error, 2)
      let res
      for (const code of up.scripts) {
        res = await call(buildExec(code, tabId), socketPath, timeoutMs).catch((e) => die(e.message, 2))
        if (!res.ok) return report(res, { json })
      }
      return report(res, { json, pretty: (r) => (r.result?.files ?? []).join('\n') })
    }

    case 'click': {
      // A real CDP mouse click. The target is resolved INSIDE the page (css
      // selector / visible text / raw viewport coordinates), then clicked at its
      // centre — no hand-built MouseEvent, which real apps ignore anyway.
      const built = buildClick(tabId, {
        selector: flags.selector,
        text: flags.text,
        ...clickPositional(flags, positionals),
        nth: flags.nth,
        scroll: flags.scroll === true
      })
      if ('error' in built) return die(built.error, 2)
      return send(built.request, {
        json,
        pretty: (r) => `clicked ${r.target ?? 'point'} at ${r.x},${r.y}`
      })
    }

    case 'snap':
    case 'snapshot':
      // The page as a numbered table of what it lets you do, plus its visible
      // text. The numbers are refs for `click <ref>`, `type`, `select`; any of
      // them is refused once the page moved, so snap again after each action.
      return send(buildSnapshot(tabId), { json, pretty: (r) => formatSnapshot(r) })

    case 'type': {
      const built = typePlan(tabId, positionals, flags)
      if ('error' in built) return die(built.error, 2)
      return send(built.request, { json, pretty: (r) => `typed into ${r.target}` })
    }

    case 'select': {
      const built = buildSelect(tabId, positionals[0], {
        label: positionals.slice(1).join(' ') || flags.label,
        value: flags.value
      })
      if ('error' in built) return die(built.error, 2)
      return send(built.request, {
        json,
        pretty: (r) => `selected ${JSON.stringify(r.label)} in ${r.target}`
      })
    }

    case 'wait': {
      // Block until a condition holds in the page, instead of sleeping blind.
      const built = buildWait(tabId, {
        selector: flags.selector,
        text: flags.text,
        url: flags.url,
        host: flags.host,
        gone: flags.gone === true,
        timeout: flags.timeout
      })
      if ('error' in built) return die(built.error, 2)
      return send(built.request, { json, pretty: (r) => `${r.condition} after ${r.waitedMs}ms` })
    }

    case 'batch': {
      // Many lines, ONE connection, one process, one agent turn.
      const arg = positionals[0]
      if (!arg) return die('batch needs @file or - (stdin)', 2)
      let text
      try {
        text = arg === '-' ? readFileSync(0, 'utf8') : readFileSync(arg.replace(/^@/, ''), 'utf8')
      } catch (e) {
        return die(`cannot read ${arg}: ${e instanceof Error ? e.message : String(e)}`, 2)
      }
      const parsed = parseBatchScript(text)
      if ('error' in parsed) return die(parsed.error, 2)
      // Build EVERY request before the first one goes out: a typo on line 7 must
      // not leave the page half-driven, in a state nobody described.
      const plan = buildBatch(parsed.lines, {
        tabId,
        cwd: process.cwd(),
        home: homedir(),
        readFile: (f) => readFileSync(f, 'utf8')
      })
      if ('error' in plan) return die(plan.error, 2)

      const session = await openSession(socketPath, timeoutMs).catch((e) => die(e.message, 2))
      const results = []
      let stop = false
      for (const step of plan.steps) {
        if (stop) {
          results.push({ ...step, skipped: true })
          continue
        }
        const response = await session
          .ask(step.request)
          .catch((e) => ({ ok: false, error: e instanceof Error ? e.message : String(e) }))
        results.push({ ...step, response })
        if (response.ok !== true && flags['keep-going'] !== true) stop = true
      }
      session.close()
      const failed = results.filter((r) => !r.skipped && r.response.ok !== true).length
      const out = json
        ? JSON.stringify({ ok: failed === 0, results: results.map((r) => r.response ?? null) })
        : formatBatchResults(results)
      return process.stdout.write(out + '\n', () => process.exit(failed === 0 ? 0 : 1))
    }

    case 'press': {
      const key = positionals[0]
      const modifiers =
        typeof flags.mod === 'string'
          ? flags.mod
              .split(',')
              .map((m) => m.trim())
              .filter(Boolean)
          : []
      const built = buildPress(key, tabId, modifiers)
      if ('error' in built) return die(built.error, 2)
      return send(built.request, { json })
    }

    case 'reload':
      return send(buildReload(tabId), { json })

    case 'shot':
    case 'screenshot': {
      // Capture the pinned/active tab to a PNG. The path is resolved against
      // THIS shell's cwd (Mira's own is unrelated and its daemon refuses a
      // relative one); no path at all means userData/screenshots/shot-<ts>.png.
      const built = buildScreenshot(positionals[0], tabId, {
        full: flags.full === true,
        cwd: process.cwd(),
        home: homedir()
      })
      return send(built.request, { json, pretty: (r) => formatScreenshot(r) })
    }

    case 'console':
      // Read the captured web-page console (console.* + browser lines: failed
      // loads/403, CORS, CSP, exceptions) of the pinned/active tab. Flags:
      // --level <verbose|info|warning|error>, --limit <n>, --since <seq>.
      return send(
        buildConsole(tabId, { level: flags.level, limit: flags.limit, since: flags.since }),
        {
          json,
          pretty: (r) => formatConsole(r.messages)
        }
      )

    case 'windows':
      return send({ command: 'list-windows' }, { json, pretty: (r) => formatWindows(r.windows) })

    case 'done': {
      // Close this Claude session's own window. Nothing to do outside a session.
      const sessionId = (process.env.CLAUDE_CODE_SESSION_ID ?? '').trim()
      if (!sessionId)
        return die('done: not inside a Claude Code session (no CLAUDE_CODE_SESSION_ID)', 2)
      return send(
        { command: 'close-session-window', params: { sessionId } },
        {
          json,
          pretty: (r) => (r.closed ? `closed ${r.windowIds.join(', ')}` : 'no session window open')
        }
      )
    }

    case 'nav':
    case 'navigate': {
      const url = positionals[0]
      if (!url) return die('nav needs a url', 2)
      // In place by default (URL-bar semantics); --new-tab / -n spawns a fresh
      // tab instead, leaving the active tab untouched. --background / -b loads
      // that new tab hidden (no visible change in the window). The pinned/--tab
      // target rides along, so this navigates the tab it was aimed at rather
      // than whatever the focused window happens to be showing.
      return send(
        buildNav(url, await navTargetTab(), {
          newTab: flags['new-tab'] === true,
          background: background(flags)
        }),
        { json }
      )
    }

    case 'open': {
      // "open" == navigate into a NEW tab: the non-destructive verb. The current
      // tab keeps its page. The registry dedups to an existing tab on same URL —
      // except with a pinned target, where the new tab opens beside it (that is
      // also what picks the window).
      const url = positionals[0]
      if (!url) return die('open needs a url', 2)
      return send(
        buildNav(url, await navTargetTab(), { newTab: true, background: background(flags) }),
        {
          json
        }
      )
    }

    case 'focus': {
      // Bring ONE window to the front: --window <id> (from `mira windows`), else
      // Mira's last-focused window. The only command that foregrounds the app.
      // With --tab, that tab is made active first and ITS window is the one
      // raised: raising a window while another tab keeps the screen reads as a
      // no-op to whoever asked for that page.
      if (flags.tab !== undefined) {
        const plan = buildActivateTab(flags.tab)
        if ('error' in plan) return die(plan.error, 2)
        const res = await call(plan, socketPath).catch((e) => die(e.message, 2))
        if (!res.ok) return die(JSON.stringify(res), 1)
        return send(buildFocus(flags.window ?? res.windowId), { json })
      }
      return send(buildFocus(flags.window), { json })
    }

    case 'use': {
      // Prints `export MIRA_TAB=<id>` to stdout (for `eval "$(mira use ...)"`).
      // Diagnostics go to stderr so they never pollute what eval consumes.
      if (positionals[0]) {
        process.stdout.write(`export MIRA_TAB=${positionals[0]}\n`)
        return process.exit(0)
      }
      const res = await call({ command: 'list-tabs' }, socketPath).catch((e) => die(e.message, 2))
      if (!res.ok) return die(JSON.stringify(res), 1)
      if (flags.active) {
        if (!res.activeId) return die('no active tab', 1)
        process.stdout.write(`export MIRA_TAB=${res.activeId}\n`)
        return process.exit(0)
      }
      if (typeof flags.url === 'string') {
        const pick = pickTabByUrl(res.tabs, flags.url)
        if ('error' in pick) {
          if (pick.matches)
            for (const m of pick.matches) process.stderr.write(`  ${m.id}  ${m.url ?? ''}\n`)
          return die(pick.error, 1)
        }
        process.stdout.write(`export MIRA_TAB=${pick.tab.id}\n`)
        return process.exit(0)
      }
      return die('use: pass <id>, --url <substr>, or --active', 2)
    }

    case 'cookies':
    case 'dump-cookies': {
      // Prints the bare cookie string (name=value; …) for the active tab's site,
      // HttpOnly included, so it pipes straight into an env var:
      //   export KONDO_COOKIE="$(mira cookies)"
      // --url targets another site; --json returns the {url,cookie,count} envelope.
      // --netscape prints a Netscape cookie jar instead, the format yt-dlp, curl -b
      // and wget read (yt-dlp --cookies <file>): Instagram reels need the login.
      const params = typeof flags.url === 'string' ? { url: flags.url } : {}
      if (tabId) params.tabId = tabId
      const netscape = (r) => {
        const host = new URL(r.url).hostname.replace(/^www\./, '')
        const rows = r.cookie.split('; ').filter((p) => p.includes('=')).map((p) => {
          const i = p.indexOf('=')
          return ['.' + host, 'TRUE', '/', 'TRUE', '2147483647', p.slice(0, i), p.slice(i + 1)].join('\t')
        })
        return ['# Netscape HTTP Cookie File', ...rows].join('\n')
      }
      return send({ command: 'dump-cookies', params }, { json, pretty: flags.netscape ? netscape : (r) => r.cookie })
    }

    case 'forget': {
      // Wipe a domain's cookies + storage + history (all subdomains) in a
      // profile, no tab required: mira forget linkedin.com [--profile <id>]
      const domain = positionals[0]
      if (!domain) return die('forget needs a domain (e.g. mira forget linkedin.com)', 2)
      const params = { domain }
      if (typeof flags.profile === 'string') params.profileId = flags.profile
      return send(
        { command: 'forget-domain', params },
        {
          json,
          pretty: (r) =>
            `cleared ${r.domain}: ${r.cookiesRemoved} cookies, ${r.historyRemoved} history`
        }
      )
    }

    case 'call': {
      const name = positionals[0]
      if (!name) return die('call needs a command name', 2)
      const built = buildCall(name, flags.params, tabId)
      if ('error' in built) return die(built.error, 2)
      return send(built.request, { json })
    }

    default: {
      // Shorthand: `mira <any-command> [--params '<json>']` == `mira call ...`.
      const built = buildCall(command, flags.params, tabId)
      if ('error' in built) return die(built.error, 2)
      return send(built.request, { json })
    }
  }
}

main().catch((e) => die(e instanceof Error ? e.message : String(e), 2))
